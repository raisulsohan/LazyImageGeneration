{
  "manifest_version": 3,
  "name": "Lazy-Image — After Effects Bridge",
  "version": "1.0.0",
  "description": "Connects Adobe After Effects Lazy-Image panel with ChatGPT for AI image generation using your existing browser login.",
  "permissions": ["activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost:7890/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lazy-Image Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
